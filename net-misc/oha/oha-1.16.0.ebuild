RUST_MIN_VER="1.88"

inherit cargo

DESCRIPTION="HTTP load generator with a TUI, inspired by rakyll/hey"
HOMEPAGE="https://github.com/hatoo/oha"
SRC_URI="
	https://github.com/hatoo/oha/archive/refs/tags/v${PV}.tar.gz -> ${P}.gh.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="MIT Apache-2.0 BSD BSD-2 CDLA-Permissive-2.0 ISC MIT-0 Unicode-3.0 ZLIB"
SLOT="0"
KEYWORDS="~amd64 ~arm64"
IUSE="+rustls http3 native-tls vsock"
REQUIRED_USE="?? ( rustls native-tls )"

DEPEND="
	native-tls? ( dev-libs/openssl )
"
RDEPEND="${DEPEND}"

src_compile() {
	local myfeatures=(
		$(usev rustls)
		$(usev native-tls)
		$(usev vsock)
		$(usev http3)
	)
	cargo_src_compile --no-default-features --features "${myfeatures[*]}"
}

src_install() {
	cargo_src_install
	einstalldocs
}
