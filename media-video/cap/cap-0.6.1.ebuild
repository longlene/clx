RUST_MIN_VER="1.90"

inherit cargo

DESCRIPTION="CLI for Cap, an open source Loom alternative for screen recording"
HOMEPAGE="https://cap.so https://github.com/CapSoftware/Cap"
SRC_URI="
	https://github.com/CapSoftware/Cap/archive/refs/tags/cap-v${PV}.tar.gz -> ${P}.gh.tar.gz
	${CARGO_CRATE_URIS}
"
S="${WORKDIR}/Cap-cap-v${PV}"

LICENSE="AGPL-3+ Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD-2 BSD Boost-1.0 CC0-1.0"
LICENSE+="
	CDLA-Permissive-2.0 GPL-3+ ISC MIT MPL-2.0 UoI-NCSA Unicode-3.0
	Unlicense WTFPL-2 ZLIB
"
SLOT="0"
KEYWORDS="~amd64"
RESTRICT="test"

# winit pulls in both the X11 and Wayland windowing backends; ffmpeg-sys-next
# links the system ffmpeg via pkg-config; cpal's Linux backend links pipewire.
# The pinned rust-ffmpeg fork (GIT_CRATES[ffmpeg-next]) only targets FFmpeg
# up to 7.1 (its match statements over AVPixelFormat/AVCodecID/etc. are not
# exhaustive against FFmpeg 8's added variants), hence the upper bound.
DEPEND="
	dev-libs/openssl:=
	dev-libs/wayland
	media-libs/alsa-lib
	<media-video/ffmpeg-8:=
	media-video/pipewire
	x11-libs/libX11
	x11-libs/libdrm
	x11-libs/libxcb
	x11-libs/libxkbcommon
"
RDEPEND="${DEPEND}"
BDEPEND="
	llvm-core/clang
	virtual/pkgconfig
"

src_prepare() {
	default

	# Cap's own Cargo.toml redirects these two crates.io crates to the same
	# git forks pinned in GIT_CRATES, so third-party crates depending on the
	# unforked crates.io versions unify onto the fork too. cargo.eclass's
	# GIT_CRATES machinery only emits [patch.'<git-url>'] overrides, not the
	# [patch.crates-io] entries this needs, so without this cargo still
	# attempts a network checkout offline.
	cat >> "${ECARGO_HOME}/config.toml" <<- EOF || die
		[patch.crates-io]
		cidre = { path = "${WORKDIR}/cidre-bf84b67079a89d6eaf01c1dab073baaba1ea8f77/cidre" }
		reqwest = { path = "${WORKDIR}/reqwest-9b5ecbd5210a9510fde766015cabb724c1e70d2e" }
	EOF

	# ffmpeg-sys-next 7.1.3 unconditionally binds libavcodec/avfft.h, a
	# legacy FFT API dropped from FFmpeg 8's headers; ffmpeg-next never
	# references those symbols, so drop the binding rather than fail on
	# systems that happen to have a newer ffmpeg's headers on the search
	# path (bindgen otherwise can't find the header at all).
	sed -i '/\.header(search_include(&include_paths, "libavcodec\/avfft.h"))$/d' \
		"${ECARGO_HOME}"/gentoo/ffmpeg-sys-next-*/build.rs || die

	# bindgen replicates glibc's internal _IO_FILE layout by default, which
	# is not part of any stable ABI and drifts across glibc releases; on
	# this system that drift makes bindgen's own generated size checks
	# fail. FFmpeg only ever passes FILE* opaquely, so mark it opaque.
	sed -i 's/\.opaque_type("__mingw_ldbl_type_t")/&\n        .opaque_type("_IO_FILE")/' \
		"${ECARGO_HOME}"/gentoo/ffmpeg-sys-next-*/build.rs || die
}

src_compile() {
	# cargo_src_install (cargo install) resolves this workspace member
	# differently than a plain build and drags in apps/desktop's webview
	# stack (javascriptcoregtk, webkit-gtk) that ./apps/cli never actually
	# uses; build the binary directly instead.
	local -x CARGO_TARGET_DIR="${WORKDIR}/target"
	cargo_env cargo build --release -p cap || die
}

src_install() {
	local -x CARGO_TARGET_DIR="${WORKDIR}/target"
	dobin "$(cargo_target_dir)/cap"
	einstalldocs
}
