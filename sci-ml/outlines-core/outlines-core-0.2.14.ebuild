RUST_MIN_VER="1.87.0"

inherit cargo distutils-r1

DESCRIPTION="Structured Text Generation in Rust"
HOMEPAGE="
	https://github.com/dottxt-ai/outlines-core
"
SRC_URI="
	https://github.com/dottxt-ai/outlines-core/archive/refs/tags/${PV}.tar.gz -> ${P}.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="Apache-2.0"
SLOT="0"
KEYWORDS="~amd64"

RDEPEND="
	$(python_gen_cond_dep '
		dev-python/jsonschema[${PYTHON_USEDEP}]
	')
"

distutils_enable_tests pytest

src_prepare() {
	sed -i "s/^version = \"0.0.0\"/version = \"${PV}\"/" Cargo.toml || die
	distutils-r1_src_prepare
}

pkg_setup() {
	rust_pkg_setup
	python-single-r1_pkg_setup
}

src_unpack() {
	cargo_src_unpack
}
