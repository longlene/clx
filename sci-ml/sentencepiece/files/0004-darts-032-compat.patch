+// Compatibility shims for the system dev-libs/darts (darts-clone 0.32h),
+// which predates the DoubleArray::copy_array() and DoubleArray::validate()
+// helpers present in the vendored darts clone (third_party/darts_clone).
+// The double-array unit layout is identical between the two, so the same
+// behavior is re-implemented on top of the 0.32h API.
+
+#ifndef DARTS_COMPAT_H_
+#define DARTS_COMPAT_H_
+
+#include <cstddef>
+#include <cstring>
+#include <vector>
+
+#include "darts.h"
+
+namespace sentencepiece {
+
+// Makes an aligned copy of the double-array blob and attaches it to
+// `array`. `buffer` must outlive all subsequent uses of `array`.
+inline void DartsCopyArray(Darts::DoubleArray* array, const void* src,
+                           std::size_t num_bytes,
+                           std::vector<Darts::Details::DoubleArrayUnit>* buffer) {
+  const std::size_t extra_padding =
+      num_bytes % array->unit_size() == 0 ? 0 : 1;
+  buffer->resize(num_bytes / array->unit_size() + extra_padding);
+  std::memcpy(buffer->data(), src, num_bytes);
+  array->set_array(buffer->data(), buffer->size());
+}
+
+// Mirrors DoubleArray::validate(max_value_limit) from the vendored darts
+// clone: every node's derived-unit index must stay within the array and
+// leaf values must stay below max_value_limit (when it is >= 0).
+inline bool DartsValidateArray(const Darts::DoubleArray& array,
+                               int max_value_limit = -1) {
+  const auto* units =
+      static_cast<const Darts::Details::DoubleArrayUnit*>(array.array());
+  const std::size_t size = array.size();
+  if (size == 0 || units == nullptr) {
+    return false;
+  }
+  if (units[0].label() != '\0' || units[0].has_leaf() ||
+      units[0].offset() == 0 || ((0 ^ units[0].offset()) | 0xFF) >= size) {
+    return false;
+  }
+  for (std::size_t i = 1; i < size; ++i) {
+    if (units[i].label() <= 0xFF) {
+      if (((i ^ units[i].offset()) | 0xFF) >= size) {
+        return false;
+      }
+    } else if (max_value_limit >= 0 && units[i].value() >= max_value_limit) {
+      return false;
+    }
+  }
+  return true;
+}
+
+}  // namespace sentencepiece
+
+#endif  // DARTS_COMPAT_H_
