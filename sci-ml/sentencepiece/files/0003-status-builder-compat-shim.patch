--- /dev/null
+++ b/src/absl_status_builder_compat.h
@@ -0,0 +1,44 @@
+#pragma once
+// Compatibility shim for abseil >= 2025, which removed StatusBuilder and
+// ABSL_RETURN_IF_ERROR (both formerly in third_party/absl/status/
+// status_macros.h / status_builder.h). Provides the minimal API
+// sentencepiece's error paths rely on.
+#include <sstream>
+#include <string>
+#include "absl/status/status.h"
+
+namespace absl {
+
+class StatusBuilder {
+ public:
+  explicit StatusBuilder(StatusCode code) : code_(code) {}
+
+  template <typename T>
+  StatusBuilder& operator<<(const T& value) {
+    std::ostringstream oss;
+    oss << value;
+    message_ += oss.str();
+    return *this;
+  }
+
+  Status Build() const {
+    if (message_.empty())
+      return code_ == StatusCode::kOk ? OkStatus() : Status(code_, std::string());
+    return Status(code_, message_);
+  }
+
+  operator Status() const { return Build(); }
+
+ private:
+  StatusCode code_;
+  std::string message_;
+};
+
+}  // namespace absl
+
+#define ABSL_RETURN_IF_ERROR(expr)                  \
+  do {                                              \
+    auto _status_or_exit = (expr);                  \
+    if (ABSL_PREDICT_FALSE(!_status_or_exit.ok()))  \
+      return _status_or_exit;                       \
+  } while (false)
+
