)

inherit cargo distutils-r1 pypi

DESCRIPTION="High-performance Rust-based load balancer for SGLang"
HOMEPAGE="
	https://pypi.org/project/sglang-router/
	https://github.com/sgl-project/sglang
"
SRC_URI="
	$(pypi_sdist_url)
	${CARGO_CRATE_URIS}
"

LICENSE="Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD-2 BSD Boost-1.0
	CC0-1.0 CDLA-Permissive-2.0 ISC LGPL-3 MIT MPL-2.0 UoI-NCSA openssl
	Unicode-3.0 Unicode-DFS-2016 ZLIB"
SLOT="0"
KEYWORDS="~amd64"
RESTRICT="test"

RDEPEND="
	dev-python/aiohttp[${PYTHON_USEDEP}]
	dev-python/fastapi[${PYTHON_USEDEP}]
	dev-python/orjson[${PYTHON_USEDEP}]
	dev-python/setproctitle[${PYTHON_USEDEP}]
	dev-python/uvicorn[${PYTHON_USEDEP}]
"

src_prepare() {
	# sdist excludes README files that Cargo.toml/pyproject.toml reference
	touch bindings/python/README.md || die
	# pyproject.toml uses ../../README.md relative to git root, broken in sdist
	sed -i 's|readme = "../../README.md"|readme = "bindings/python/README.md"|' pyproject.toml || die
	distutils-r1_src_prepare
}
