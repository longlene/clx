	[metal-kernels]='https://github.com/guoqingbao/attention.rs;2e0db4201f159b9caf98947487de997c5dec64dd;attention.rs-%commit%/src/metal-kernels'
)

inherit cargo

DESCRIPTION="Blazing-fast LLM inference engine in pure Rust, no PyTorch/Python runtime"
HOMEPAGE="https://github.com/guoqingbao/xinfer"
SRC_URI="
	https://github.com/guoqingbao/xinfer/archive/refs/tags/v${PV}.tar.gz -> ${P}.gh.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="MIT"
# Dependent crate licenses
LICENSE+="
	0BSD Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD CC0-1.0
	CDLA-Permissive-2.0 ISC LGPL-3 MIT-0 MPL-2.0 Unicode-3.0
	Unicode-DFS-2016 ZLIB
"
SLOT="0"
KEYWORDS="~amd64"
IUSE="cuda"

RDEPEND="cuda? ( dev-util/nvidia-cuda-toolkit )"
BDEPEND="
	app-arch/xz-utils
	dev-lang/perl
	virtual/pkgconfig
"

pkg_setup() {
	rust_pkg_setup
	if use cuda; then
		# candle-kernels' and attention-rs's build.rs scripts probe nvidia-smi
		# for the target compute capability; that has no GPU access inside the
		# build sandbox, and both src_compile (cargo build) and src_install
		# (cargo install, which recompiles) need this set, so export it here
		# rather than in a single phase function. Derived from the user's own
		# TORCH_CUDA_ARCH_LIST (e.g. "8.9" -> "89").
		[[ -n ${TORCH_CUDA_ARCH_LIST} ]] || die "USE=cuda requires TORCH_CUDA_ARCH_LIST to be set (e.g. in make.conf)"
		export CUDA_COMPUTE_CAP=${TORCH_CUDA_ARCH_LIST%%[; ]*}
		CUDA_COMPUTE_CAP=${CUDA_COMPUTE_CAP//./}
	fi
}

src_prepare() {
	# Upstream ships no Cargo.lock; regenerate with `cargo generate-lockfile`
	# and refresh CRATES/GIT_CRATES via update-crates whenever bumping. Split
	# into under-20KiB xz chunks to satisfy pkgcheck's FILESDIR size limits.
	cat "${FILESDIR}"/${P}-Cargo.lock.xz.part{00,01,02} > "${T}"/Cargo.lock.xz || die
	unxz -c "${T}"/Cargo.lock.xz > "${S}"/Cargo.lock || die
	default
}

src_configure() {
	local myfeatures=( $(usev cuda) )
	cargo_src_configure
}

src_install() {
	cargo_src_install
	dodoc ReadMe.md
}
