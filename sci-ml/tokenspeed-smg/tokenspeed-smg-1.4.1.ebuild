RUST_MIN_VER="1.90.0"

DISTUTILS_EXT=1
DISTUTILS_USE_PEP517=maturin
PYTHON_COMPAT=( python3_{13..15} )

inherit cargo distutils-r1

DESCRIPTION="Engine-agnostic LLM gateway with full OpenAI and Anthropic API compatibility"
HOMEPAGE="
	https://lightseek.org/smg
	https://github.com/lightseekorg/smg
"
SRC_URI="
	https://github.com/lightseekorg/smg/archive/refs/tags/v${PV}.tar.gz -> ${P}.gh.tar.gz
	${CARGO_CRATE_URIS}
"

S="${WORKDIR}"/smg-${PV}/bindings/python

LICENSE="Apache-2.0"
# Dependent crate licenses
LICENSE+="
	Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD-2 BSD Boost-1.0
	CC0-1.0 CDLA-Permissive-2.0 ISC LGPL-3 MIT MPL-2.0 UoI-NCSA
	Unicode-3.0 Unicode-DFS-2016 Unlicense WTFPL-2 ZLIB BZIP2
"
SLOT="0"
KEYWORDS="~amd64"

DEPEND="
	app-arch/bzip2:=
	app-arch/zstd:=
	dev-libs/oniguruma:=
	dev-libs/openssl:=
"
RDEPEND="${DEPEND}
	dev-python/setproctitle[${PYTHON_USEDEP}]
	dev-python/grpcio[${PYTHON_USEDEP}]
	dev-python/grpcio-health-checking[${PYTHON_USEDEP}]
	dev-python/pyyaml[${PYTHON_USEDEP}]
"

RESTRICT="test"
