	# even when [patch.'https://...'] entries exist in CARGO_HOME/config.toml.
	local crev="6381023982251959a2c9bab7378b3013304e192b"
	local urev="8b4f18b4bcd5e4b1a9daf40abc3a2e27f83f06e9"
	local cdir="${WORKDIR}/candle-${crev}"
	local udir="${WORKDIR}/cudarc-${urev}"
	local hf="https://github.com/huggingface/candle"
	local nr="https://github.com/Narsil/cudarc"

	sed -i \
		-e "s|git = \"${nr}\" , rev = \"${urev}\"}|path = \"${udir}\" }|" \
		Cargo.toml || die "Failed to patch cudarc git source"

	local pkg
	for pkg in candle-core candle-nn candle-transformers candle-flash-attn; do
		sed -i \
		-e "s|git = \"${hf}\", rev = \"${crev}\", package = \"${pkg}\"|path = \"${cdir}/${pkg}\", package = \"${pkg}\"|" \
		Cargo.toml || die "Failed to patch ${pkg} git source"
	done

	# Patch metrics-0.23.0 for Rust 1.84+ (E0521: dyn fat pointer lifetime tracking)
	eapply --directory="${WORKDIR}/cargo_home/gentoo/metrics-0.23.0" \
		"${FILESDIR}/metrics-0.23.0-rust184-e0521.patch"

	eapply_user
}

src_install() {
	cargo_src_install --path router
	dodoc README.md
}
