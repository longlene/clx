RUST_MIN_VER="1.88.0"

inherit cargo

MOZJS_PV="0.140.10-3"

DESCRIPTION="A browser engine in a binary — fetch, render, and extract web content powered by Servo"
HOMEPAGE="https://github.com/konippi/servo-fetch"
SRC_URI="
	https://github.com/konippi/servo-fetch/archive/refs/tags/v${PV}.tar.gz -> ${P}.gh.tar.gz
	amd64? (
		https://github.com/servo/mozjs/releases/download/mozjs-sys-v${MOZJS_PV}/libmozjs-x86_64-unknown-linux-gnu.tar.gz
		-> libmozjs-${MOZJS_PV}-x86_64-unknown-linux-gnu.tar.gz
	)
	arm64? (
		https://github.com/servo/mozjs/releases/download/mozjs-sys-v${MOZJS_PV}/libmozjs-aarch64-unknown-linux-gnu.tar.gz
		-> libmozjs-${MOZJS_PV}-aarch64-unknown-linux-gnu.tar.gz
	)
	${CARGO_CRATE_URIS}
"

LICENSE="MIT"
SLOT="0"
KEYWORDS="~amd64"

DEPEND=""
RDEPEND="${DEPEND}"
BDEPEND=""

S="${WORKDIR}"/${P}/crates/${PN}-cli

src_compile() {
	local archive
	if use amd64 ; then
		archive=libmozjs-${MOZJS_PV}-x86_64-unknown-linux-gnu.tar.gz
	elif use arm64 ; then
		archive=libmozjs-${MOZJS_PV}-aarch64-unknown-linux-gnu.tar.gz
	fi
	export MOZJS_ARCHIVE="${DISTDIR}"/${archive}
	cargo_src_compile
}

src_install() {
	cargo_src_install
	einstalldocs
}
