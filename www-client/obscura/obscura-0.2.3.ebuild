RUST_MIN_VER="1.88.0"

inherit cargo

DESCRIPTION="The headless browser for AI agents and web scraping"
HOMEPAGE="https://github.com/h4ckf0r0day/obscura"
# obscura-js pulls in deno_core -> the "v8" crate, which needs a prebuilt V8
# static lib (building V8 from source needs the full depot_tools/gclient
# toolchain, infeasible in an ebuild — this is also why Gentoo only ships
# dev-lang/deno-bin, never a from-source dev-lang/deno). Pre-supply it via
# SRC_URI + RUSTY_V8_ARCHIVE so the v8 crate's build.rs doesn't try to fetch
# it itself (network access is blocked in src_compile). deno_core 0.412
# unconditionally enables the v8 "simdutf" feature, so the archive must be
# the _simdutf variant (the plain release archive lacks the simdutf__* C
# symbols the v8 binding references).
SRC_URI="
	https://github.com/h4ckf0r0day/obscura/archive/refs/tags/v${PV}.tar.gz -> ${P}.gh.tar.gz
	https://github.com/denoland/rusty_v8/releases/download/v150.4.0/librusty_v8_simdutf_release_x86_64-unknown-linux-gnu.a.gz -> librusty_v8-150.4.0-simdutf-release-x86_64-unknown-linux-gnu.a.gz
	${CARGO_CRATE_URIS}
"

LICENSE="Apache-2.0 BSD BSD-2 CDLA-Permissive-2.0 ISC MIT MPL-2.0 Unicode-3.0 ZLIB"
SLOT="0"
KEYWORDS="~amd64 ~arm64"
IUSE="render stealth"

BDEPEND="
	dev-build/cmake
"

src_compile() {
	export RUSTY_V8_ARCHIVE="${DISTDIR}/librusty_v8-150.4.0-simdutf-release-x86_64-unknown-linux-gnu.a.gz"
	local myfeatures=( $(usev render) $(usev stealth) )
	cargo_src_compile --manifest-path crates/obscura-cli/Cargo.toml --features "${myfeatures[*]}"
}

src_install() {
	cargo_src_install --path crates/obscura-cli
	einstalldocs
}
