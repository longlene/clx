	zopfli@0.8.3
"

inherit cargo

DESCRIPTION="Open-source IAM solution for cloud-native environments, written in Rust"
HOMEPAGE="https://github.com/ferriskey/ferriskey https://ferriskey.rs"
SRC_URI="
	https://github.com/ferriskey/ferriskey/archive/refs/tags/v${PV}.tar.gz -> ${P}.gh.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="Apache-2.0"
# Dependent crate licenses
LICENSE+="
	0BSD Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD-2 BSD
	CDLA-Permissive-2.0 ISC MIT MPL-2.0 openssl Unicode-3.0 ZLIB
"
SLOT="0"
KEYWORDS="~amd64"
RUST_MIN_VER="1.91.0"

# openssl-sys links against system OpenSSL (via ldap3)
DEPEND="dev-libs/openssl:="
RDEPEND="${DEPEND}"

src_compile() {
	cargo_src_compile --package ferriskey-api
}

src_install() {
	cargo_src_install --path api
	dodoc README.md CONTRIBUTING.md
}
