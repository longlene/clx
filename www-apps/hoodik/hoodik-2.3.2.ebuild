DESCRIPTION="Self-hosted end-to-end encrypted file storage server"
HOMEPAGE="https://github.com/hudikhq/hoodik"
SRC_URI="
	https://github.com/hudikhq/hoodik/archive/refs/tags/v${PV}.tar.gz -> ${P}.gh.tar.gz
	${CARGO_CRATE_URIS}
"
S="${WORKDIR}/${P}/hoodik"

LICENSE="CC-BY-NC-4.0 0BSD Apache-2.0 BSD CC0-1.0 CDLA-Permissive-2.0 ISC MIT MPL-2.0 Unicode-3.0 ZLIB"
SLOT="0"
KEYWORDS="~amd64"
RESTRICT="mirror"

DEPEND="dev-db/sqlite:3="
RDEPEND="${DEPEND}"

src_compile() {
	# aegis crate cc-rs build passes CFLAGS to clang; -mabm is not supported by clang
	filter-flags -mabm
	cargo_src_compile
}

src_install() {
	cargo_src_install
	dodoc "${WORKDIR}/${P}/README.md"
}
