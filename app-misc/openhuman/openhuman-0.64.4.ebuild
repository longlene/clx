declare -A GIT_CRATES=(
	[tinytools-agent]='https://github.com/tinyhumansai/tinytools;a5d04a7f3af0abc1dd748f87f94871b36ae9fe71;tinytools-%commit%/crates/tinytools-agent'
	[tinytools]='https://github.com/tinyhumansai/tinytools;a5d04a7f3af0abc1dd748f87f94871b36ae9fe71;tinytools-%commit%/crates/tinytools'
)

inherit cargo git-r3

EGIT_REPO_URI="https://github.com/tinyhumansai/openhuman.git"
# Tagged release; the vendor/* submodules (some upstream branch=main) are
# pinned to the commits recorded in the tag.
EGIT_COMMIT="v${PV}"
EGIT_MIN_CLONE_TYPE="shallow"
DESCRIPTION="Fast, efficient open-source agent harness from TinyHumans"
HOMEPAGE="https://github.com/tinyhumansai/openhuman"

# All native code (ring, bundled sqlite3) compiles from crate sources —
# no system libraries required.
SRC_URI="${CARGO_CRATE_URIS}"

LICENSE="GPL-3"
# Dependent crate licenses
LICENSE+="
	0BSD Apache-2.0 BSD-2 BSD Boost-1.0 CDLA-Permissive-2.0 GPL-3 ISC
	MIT MPL-2.0 Unicode-3.0 Unicode-DFS-2016 WTFPL-2 ZLIB
"
SLOT="0"
KEYWORDS="~amd64 ~arm64"

src_prepare() {
	default
	# openhuman-core already path-depends on the vendored tinyjevclient
	# (vendor/tinybrowser submodule, identical commit); point the
	# CLI/tinyhumans git deps at the same copy so the offline build
	# resolves a single unambiguous source.
	local jv='../../vendor/tinybrowser/vendor/tinyjevclient/crates/tinyjevclient'
	sed -i \
		-e "s|{ git = \"https://github.com/tinyhumansai/tinyjevclient\", rev = \"[0-9a-f]*\"|{ path = \"${jv}\"|" \
		"${S}"/crates/openhuman-cli/Cargo.toml \
		"${S}"/crates/openhuman-tinyhumans/Cargo.toml || die
}

src_unpack() {
	git-r3_src_unpack
	cargo_src_unpack
}

src_compile() {
	cargo_src_compile
}

src_install() {
	# User-facing binaries; the remaining workspace bins are dev/bench tools.
	dobin "$(cargo_target_dir)"/openhuman-core "$(cargo_target_dir)"/openhuman-tui
	dodoc README.md LICENSE
}
