inherit cargo

DESCRIPTION="Fast, lightweight & schema-less search backend"
HOMEPAGE="https://github.com/valeriansaliou/sonic"
SRC_URI="
	https://github.com/valeriansaliou/sonic/archive/refs/tags/v${PV}.tar.gz -> ${P}.gh.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="Apache-2.0 BSD CC0-1.0 CDLA-Permissive-2.0 ISC MIT MPL-2.0 Unicode-3.0 ZLIB"
SLOT="0"
KEYWORDS="~amd64 ~arm64"

src_prepare() {
	default
	sed -e '/strip = true/d' \
		-i Cargo.toml
}

src_install() {
	cargo_src_install --path server
	einstalldocs
}
