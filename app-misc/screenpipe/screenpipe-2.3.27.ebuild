HOMEPAGE="https://screenpipe.com https://github.com/screenpipe/screenpipe"
SRC_URI="
	https://github.com/screenpipe/screenpipe/archive/refs/tags/v${PV}.tar.gz -> ${P}.gh.tar.gz
	https://github.com/ggerganov/whisper.cpp/archive/${WHISPER_CPP_COMMIT}.tar.gz -> ${PN}-whisper.cpp-${WHISPER_CPP_COMMIT}.tar.gz
	https://github.com/antirez/qwen-asr/archive/${QWEN_ASR_COMMIT}.tar.gz -> ${PN}-qwen-asr-${QWEN_ASR_COMMIT}.tar.gz
	https://github.com/predict-woo/qwen3-asr.cpp/archive/${QWEN3_ASR_CPP_COMMIT}.tar.gz -> ${PN}-qwen3-asr.cpp-${QWEN3_ASR_CPP_COMMIT}.tar.gz
	${CARGO_CRATE_URIS}
"

S="${WORKDIR}/${P}/crates/screenpipe-engine"

LICENSE="|| ( Apache-2.0 MIT )"
# Dependent crate licenses
LICENSE+="
	0BSD Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD-2 BSD CC0-1.0
	CDLA-Permissive-2.0 ISC LGPL-3 MIT MPL-2.0 UoI-NCSA Unicode-3.0
	Unlicense ZLIB
"
SLOT="0"
KEYWORDS="~amd64"
IUSE="pulseaudio"

# alsa-sys, libpulse-sys, libsamplerate-sys, drm-sys, gbm-sys, pipewire-sys,
# wayland-sys, libsqlite3-sys, openssl-sys, lzma-sys, mp3lame-sys
# rusty-tesseract (git dep) links against system tesseract
DEPEND="
	media-libs/alsa-lib:=
	media-libs/libsamplerate:=
	media-libs/mesa:=
	media-video/pipewire:=
	dev-libs/wayland:=
	dev-db/sqlite:3=
	dev-libs/openssl:=
	app-arch/xz-utils:=
	media-sound/lame:=
	app-text/tesseract:=
	x11-libs/libdrm:=
	sci-libs/openblas:=
	pulseaudio? ( media-libs/libpulse:= )
"
RDEPEND="${DEPEND}
	media-video/ffmpeg:=
"
# clang-sys (bindgen) needs LLVM/Clang at build time
# aws-lc-sys needs nasm for assembly
BDEPEND="
	llvm-core/clang
	dev-lang/nasm
"

src_prepare() {
	local hfhub="${WORKDIR}/hf-hub-437dcf4049233f4a0e0cfc4e1c1dbf5ed2c57760"
	# The workspace Cargo.toml declares hf-hub as a git dep; redirect it to
	# the pre-fetched local path so cargo doesn't attempt network access.
	perl -i -0777 -pe \
		's|hf-hub = \{ version = "0\.3\.2", git = "https://github\.com/neo773/hf-hub".*?\] \}|hf-hub = { version = "0.3.2", path = "'"${hfhub}"'", default-features = false, features = ["rustls-tls", "tokio", "ureq"] }|s' \
		"${WORKDIR}/${P}/Cargo.toml" || die
	sed -i \
		"s|hf-hub = { git = \"https://github.com/neo773/hf-hub\" }|hf-hub = { path = \"${hfhub}\" }|" \
		"${WORKDIR}/${P}/Cargo.toml" || die
	sed -i \
		'/^source = "git+https:\/\/github\.com\/neo773\/hf-hub#/d' \
		"${WORKDIR}/${P}/Cargo.lock" || die
	# whisper-rs uses whisper.cpp as a git submodule; populate the empty dir
	# from the separately fetched tarball
	cp -r "${WORKDIR}/whisper.cpp-${WHISPER_CPP_COMMIT}/." \
		"${WORKDIR}/whisper-rs-97e40705033724dee601e89f3bd701af8096c846/sys/whisper.cpp/" || die
	# audiopipe uses qwen-asr and qwen3-asr.cpp as git submodules
	# antirez-asr-sys build.rs passes -std=c11 which hides strdup (POSIX, not ISO C)
	# add the define to the cc::Build object before any file is compiled
	sed -i '/build\.warnings(false)\.opt_level(3)\.include(&src);/a\\tbuild.define("_POSIX_C_SOURCE", Some("200809L"));' \
		"${WORKDIR}/audiopipe-d9cf445483c6a8ea24a5eb6ee92c84353408cba6/crates/antirez-asr-sys/build.rs" || die
	# build.rs incorrectly emits "libopenblas" (adds a spurious lib prefix);
	# the correct link name is "openblas" so the linker finds libopenblas.so
	sed -i 's/dylib=libopenblas/dylib=openblas/' \
		"${WORKDIR}/audiopipe-d9cf445483c6a8ea24a5eb6ee92c84353408cba6/crates/antirez-asr-sys/build.rs" || die
	cp -r "${WORKDIR}/qwen-asr-${QWEN_ASR_COMMIT}/." \
		"${WORKDIR}/audiopipe-d9cf445483c6a8ea24a5eb6ee92c84353408cba6/crates/antirez-asr-sys/qwen-asr/" || die
	cp -r "${WORKDIR}/qwen3-asr.cpp-${QWEN3_ASR_CPP_COMMIT}/." \
		"${WORKDIR}/audiopipe-d9cf445483c6a8ea24a5eb6ee92c84353408cba6/crates/qwen3-asr-sys/qwen3-asr.cpp/" || die
	default
}

src_compile() {
	local myfeatures=(
		$(usev pulseaudio)
	)
	cargo_src_compile --features "${myfeatures[*]}"
}

src_install() {
	cargo_src_install
	dodoc "${WORKDIR}/${P}/README.md"
}
