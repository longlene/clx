inherit cargo

DESCRIPTION="Agent-first CLI client for the Buzz relay"
HOMEPAGE="https://github.com/block/buzz"
SRC_URI="
	https://github.com/block/buzz/archive/refs/tags/v${PV}.tar.gz -> ${P}.gh.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="Apache-2.0 BSD-2 BSD Boost-1.0 BlueOak-1.0.0 CC0-1.0 CDLA-Permissive-2.0 ISC MIT MPL-2.0 Unicode-3.0 Unicode-DFS-2016 Unlicense WTFPL-2 ZLIB"
SLOT="0"
KEYWORDS="~amd64"

BDEPEND="virtual/pkgconfig"

src_prepare() {
	# Cargo.toml's root [patch.crates-io] redirects aws-creds (a rust-s3
	# dep, unrelated to buzz-cli's own code) to a git fork. Root-level
	# [patch] entries are evaluated eagerly for the whole workspace
	# regardless of which package is later selected with -p, and
	# cargo.eclass's config-level GIT_CRATES patching does not intercept a
	# patch layered on top of crates-io (see cargo.eclass double-patch
	# caveat), so cargo tries to fetch it and fails offline. Point the
	# patch straight at the already-vendored GIT_CRATES checkout instead;
	# Cargo.lock is left untouched, so this only affects the aws-creds
	# entry and cargo reconciles it locally without any network access.
	sed -i -e "s|git = \"https://github.com/tlongwell-block/rust-s3\"[^}]*}|path = \"${WORKDIR}/rust-s3-c9fce3620dd434c1f810101d672cf384268dbb0f/aws-creds\" }|" Cargo.toml || die
	default
}

src_compile() {
	cargo_src_compile -p buzz-cli
}

src_install() {
	cargo_src_install --path crates/buzz-cli
	dodoc README.md
}
