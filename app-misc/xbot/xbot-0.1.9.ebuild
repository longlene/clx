inherit cargo

DESCRIPTION="A minimal Rust AI agent for vibe coding and task automation"
HOMEPAGE="https://github.com/guoqingbao/xbot"
SRC_URI="
	https://github.com/guoqingbao/xbot/archive/refs/tags/v${PV}.tar.gz -> ${P}.gh.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="MIT"
# Dependent crate licenses
LICENSE+="
	0BSD Apache-2.0 BSD Boost-1.0 CDLA-Permissive-2.0 ISC MPL-2.0
	Unicode-3.0 ZLIB
"
SLOT="0"
KEYWORDS="~amd64"

BDEPEND="
	app-arch/xz-utils
	dev-lang/perl
	virtual/pkgconfig
"

src_prepare() {
	# Upstream ships no Cargo.lock; regenerate with `cargo generate-lockfile`
	# and refresh CRATES via update-crates whenever bumping. Split into
	# under-20KiB xz chunks to satisfy pkgcheck's FILESDIR size limits.
	cat "${FILESDIR}"/${P}-Cargo.lock.xz.part{00,01,02} > "${T}"/Cargo.lock.xz || die
	unxz -c "${T}"/Cargo.lock.xz > "${S}"/Cargo.lock || die
	default
}

src_install() {
	cargo_src_install
	dodoc README.md
}
