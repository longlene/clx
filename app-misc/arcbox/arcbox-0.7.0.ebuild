RUST_MIN_VER="1.96.0"

inherit cargo

DESCRIPTION="Run AI agents on real and isolated machines"
HOMEPAGE="https://github.com/arcboxlabs/arcbox"
SRC_URI="
	https://github.com/arcboxlabs/arcbox/archive/refs/tags/v${PV}.tar.gz -> ${P}.gh.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="|| ( Apache-2.0 MIT ) Apache-2.0 BSD CC0-1.0 CDLA-Permissive-2.0 ISC MIT MPL-2.0 Unicode-3.0 ZLIB"
SLOT="0"
KEYWORDS="~amd64 ~arm64"

src_prepare() {
	eapply "${FILESDIR}"/0.7.0-*.patch
	eapply_user
}

# The arcbox-helper binary is a macOS-only code-signing verification server
# (its bin target fails to compile for Linux release builds upstream);
# the helper's lib is still built as a dependency of the daemon and CLI.
src_compile() {
	cargo_src_compile -p arcbox-cli -p arcbox-daemon -p arcbox-agent
}

src_install() {
	cargo_src_install --path app/arcbox-cli
	cargo_src_install --path app/arcbox-daemon
	cargo_src_install --path guest/arcbox-agent
	einstalldocs
}
