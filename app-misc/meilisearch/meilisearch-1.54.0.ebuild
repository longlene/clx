declare -A GIT_CRATES=(
	[bbqueue]='https://github.com/meilisearch/bbqueue;e8af4a4bccc8eb36b2b0442c4a9c5cb839d1cea2;bbqueue-%commit%/core'
)

RUST_MIN_VER="1.98.1"

inherit cargo systemd

DASHBOARD_PV="0.4.2"

DESCRIPTION="Lightning-fast search engine with a RESTful API"
HOMEPAGE="
	https://www.meilisearch.com/
	https://github.com/meilisearch/meilisearch
"
SRC_URI="
	https://github.com/meilisearch/meilisearch/archive/refs/tags/v${PV}.tar.gz -> ${P}.gh.tar.gz
	dashboard? (
		https://github.com/meilisearch/mini-dashboard/releases/download/v${DASHBOARD_PV}/build.zip
			-> meilisearch-mini-dashboard-${DASHBOARD_PV}.zip.dist
	)
	${CARGO_CRATE_URIS}
"

# meilisearch is MIT; Enterprise Edition parts (BUSL-1.1) are only built
# with the upstream "enterprise" feature, which is not enabled here
LICENSE="MIT"
# Dependent crate licenses
LICENSE+="
	0BSD Apache-2.0 BSD-2 BSD CC0-1.0 CDLA-Permissive-2.0 ISC LGPL-2 MIT
	MPL-2.0 Unicode-3.0 ZLIB
"
SLOT="0"
KEYWORDS="~amd64"
IUSE="+dashboard"
# tests need network access and a long runtime
RESTRICT="test"

RDEPEND="
	acct-group/meilisearch
	acct-user/meilisearch
"
BDEPEND="llvm-core/clang"

QA_FLAGS_IGNORED="usr/bin/meilisearch"

src_prepare() {
	default

	# build.rs downloads the prebuilt mini-dashboard; read it from DISTDIR
	local fetch='get(url)?.bytes()?'
	local read='std::fs::read(env::var("MEILI_DASHBOARD_ZIP")?)?'
	sed -i -e "s|${fetch}|${read}|" crates/meilisearch/build.rs || die
	grep -q MEILI_DASHBOARD_ZIP crates/meilisearch/build.rs || die "build.rs patch failed"
}

src_compile() {
	local myfeatures=( meilisearch-types/all-tokenizations )
	if use dashboard; then
		myfeatures+=( mini-dashboard )
		export MEILI_DASHBOARD_ZIP="${DISTDIR}/meilisearch-mini-dashboard-${DASHBOARD_PV}.zip.dist"
	fi
	export MEILI_NO_ANALYTICS=true
	cargo_src_compile -p meilisearch --no-default-features --features "${myfeatures[*]}"
}

src_install() {
	dobin "$(cargo_target_dir)"/meilisearch
	dodoc README.md

	insinto /etc
	newins config.toml meilisearch.toml
	keepdir /var/lib/meilisearch
	systemd_newunit - meilisearch.service <<-EOF
		[Unit]
		Description=Meilisearch search engine
		After=network-online.target

		[Service]
		User=meilisearch
		Group=meilisearch
		ExecStart=/usr/bin/meilisearch --config-file-path /etc/meilisearch.toml
		WorkingDirectory=/var/lib/meilisearch

		[Install]
		WantedBy=multi-user.target
	EOF
}

pkg_postinst() {
	chown meilisearch:meilisearch "${EROOT}"/var/lib/meilisearch || die
	chmod 0750 "${EROOT}"/var/lib/meilisearch || die

	elog "The service runs in /var/lib/meilisearch, where the relative db_path"
	elog "and dump_dir of /etc/meilisearch.toml resolve. Set env = \"production\""
	elog "and a master_key there before exposing it."
}
