--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -105,7 +105,23 @@
   # Clang/LLVM 22+ supports SM 100+, and CUDA 13.4+ toolchains enable SM 107.
   set(BITCODE_LIB_ARCHS "")
   if(LLVM_VERSION_MAJOR GREATER_EQUAL 22 AND CUDAToolkit_VERSION VERSION_GREATER_EQUAL 13.4)
-    set(_CLANG_MAX_SM 107)
+    # A clang binary only accepts sm_107 when it was built against a CUDA
+    # toolkit with SM 107 support, so verify the discovered compiler.
+    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/_nvshmem_sm107_probe.cu"
+         "__global__ void _nvshmem_sm107_probe() {}\n")
+    execute_process(
+        COMMAND ${NVSHMEM_CLANG_EXECUTABLE} -x cuda --cuda-path=${CUDA_HOME}
+                --cuda-device-only --cuda-gpu-arch=sm_107
+                -c "${CMAKE_CURRENT_BINARY_DIR}/_nvshmem_sm107_probe.cu"
+                -o "${CMAKE_CURRENT_BINARY_DIR}/_nvshmem_sm107_probe.o"
+        RESULT_VAR _nvshmem_sm107_ok
+        OUTPUT_QUIET ERROR_QUIET)
+    if(_nvshmem_sm107_ok EQUAL 0)
+      set(_CLANG_MAX_SM 107)
+    else()
+      message(STATUS "Skipping bitcode for sm_107 (Clang ${LLVM_VERSION_MAJOR} lacks SM 107 support)")
+      set(_CLANG_MAX_SM 100)
+    endif()
   elseif(LLVM_VERSION_MAJOR GREATER_EQUAL 22)
     set(_CLANG_MAX_SM 100)
   else()
