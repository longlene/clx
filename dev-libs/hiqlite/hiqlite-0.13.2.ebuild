inherit cargo

DESCRIPTION="Highly-available, embeddable, raft-based SQLite and cache for Rust"
HOMEPAGE="https://github.com/sebadob/hiqlite"
SRC_URI="
	https://github.com/sebadob/hiqlite/archive/refs/tags/v${PV}.tar.gz -> ${P}.gh.tar.gz
	${CARGO_CRATE_URIS}
"

S="${WORKDIR}/${P}/hiqlite"

LICENSE="Apache-2.0"
# Dependent crate licenses
LICENSE+=" Apache-2.0 BSD CDLA-Permissive-2.0 ISC MIT Unicode-3.0 ZLIB"
SLOT="0"
KEYWORDS="~amd64"
IUSE="jemalloc"
RUST_MIN_VER="1.91.0"

src_compile() {
	local myfeatures=( server $(usev jemalloc) )
	cargo_src_compile --features "${myfeatures[*]}"
}

src_install() {
	cargo_src_install --features "server $(usev jemalloc)"
	einstalldocs
}
