inherit cargo

DESCRIPTION="A feature-rich TUI client for Discord"
HOMEPAGE="https://github.com/chojs23/concord"
SRC_URI="
	https://github.com/chojs23/concord/archive/refs/tags/v${PV}.tar.gz -> ${P}.gh.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="GPL-3 0BSD Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD-2 BSD Boost-1.0 CDLA-Permissive-2.0 ISC MIT MPL-2.0 UoI-NCSA Unicode-3.0 Unicode-DFS-2016 WTFPL-2 ZLIB"
SLOT="0"
KEYWORDS="~amd64"
IUSE="+voice-playback +stream-broadcast"
REQUIRED_USE="stream-broadcast? ( voice-playback )"

RDEPEND="
	voice-playback? ( media-libs/alsa-lib )
	stream-broadcast? (
		media-libs/libva:=
		media-libs/mesa
		media-video/pipewire:=
	)
"
DEPEND="${RDEPEND}"
BDEPEND="
	dev-build/cmake
	llvm-core/clang:=
	virtual/pkgconfig
	stream-broadcast? ( dev-lang/nasm )
"

src_configure() {
	local myfeatures=(
		$(usev voice-playback)
		$(usev stream-broadcast)
	)
	cargo_src_configure --no-default-features
}

src_install() {
	cargo_src_install
	einstalldocs
}
