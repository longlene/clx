RUST_MIN_VER="1.97.0"

inherit cargo

DESCRIPTION="Observability platform for logs, metrics and traces (server, no web UI)"
HOMEPAGE="https://openobserve.ai/ https://github.com/openobserve/openobserve"
SRC_URI="
	https://github.com/openobserve/openobserve/archive/refs/tags/v${PV}.tar.gz -> ${P}.gh.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="AGPL-3"
# Dependent crate licenses
LICENSE+="
	0BSD Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD-2 BSD Boost-1.0
	BZIP2 CC0-1.0 CDDL CDLA-Permissive-2.0 ISC MIT MIT-0 MPL-2.0
	Unicode-3.0 ZLIB
"
SLOT="0"
KEYWORDS="~amd64"

BDEPEND="
	dev-build/cmake
	dev-libs/protobuf
"

QA_FLAGS_IGNORED="usr/bin/${PN}"

src_prepare() {
	default

	# cargo does not chain patches: git sources that are only reached via
	# the manifest's [patch.crates-io] ignore the eclass-generated config
	# patches, so point those entries at the unpacked GIT_CRATES directly
	local crate url commit dir entry
	for crate in "${!GIT_CRATES[@]}"; do
		IFS=';' read -r url commit dir <<< "${GIT_CRATES[${crate}]}"
		dir=${dir//%commit%/${commit}}
		entry="${crate} = { path = \"${WORKDIR}/${dir}\" }"
		sed -i -E "/^\[patch\.crates-io\]/,/^\[/ s|^${crate} = \{ git = \"${url}\"[^}]*\}|${entry}|" \
			Cargo.toml || die
	done

	# build.rs derives the version from git, which a tarball does not have
	sed -i \
		-e 's|Command::new("git")|Command::new("true")|' \
		-e "s|let git_tag = String::from_utf8(output.stdout).unwrap();|let git_tag = \"v${PV}\";|" \
		-e "s|let git_commit = String::from_utf8(output.stdout).unwrap();|let git_commit = \"v${PV}\";|" \
		src/config/build.rs || die

	# The web UI (web/dist) is embedded at compile time; building it needs
	# ~1400 npm packages, so ship the server with a placeholder page only.
	mkdir -p web/dist || die
	cat > web/dist/index.html <<-EOF || die
		<!doctype html><title>OpenObserve</title>
		<p>This OpenObserve build does not include the web UI.
		Use the HTTP API at /api/.</p>
	EOF
}

src_compile() {
	# pinned to a nightly toolchain for a few unstable library features
	export RUSTC_BOOTSTRAP=1
	cargo_src_compile --bin openobserve
}

src_install() {
	cargo_src_install --bin openobserve
	dodoc README.md
}
