LLVM_COMPAT=( 17 21 22 23 )

inherit cargo desktop llvm-r2

DESCRIPTION="Native GPUI workbench for the pi coding agent"
HOMEPAGE="https://github.com/imrj05/orbit"
SRC_URI="
	https://github.com/imrj05/orbit/archive/refs/tags/v${PV}.tar.gz -> ${P}.gh.tar.gz
	${CARGO_CRATE_URIS}
"
S="${WORKDIR}/orbit-${PV}"

LICENSE="Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD BSD-2 CC0-1.0 CDLA-Permissive-2.0 ISC MIT MPL-2.0 UoI-NCSA Unicode-3.0 ZLIB"
SLOT="0"
KEYWORDS="~amd64"
RESTRICT="test"

BDEPEND="
	dev-libs/wayland-protocols
	dev-python/pkgconfig
	dev-util/wayland-scanner
	$(llvm_gen_dep '
		llvm-core/clang:=
		llvm-core/llvm:=
	')
"
DEPEND="
	dev-libs/wayland
	dev-libs/libgit2:=
	x11-libs/libX11
	x11-libs/libxcb:=
	x11-libs/libxkbcommon
	media-libs/fontconfig
	media-libs/freetype
	media-libs/vulkan-loader
	virtual/zlib:=
"
RDEPEND="${DEPEND}"

pkg_setup() {
	rust_pkg_setup
}

src_install() {
	# root Cargo.toml is a virtual manifest (workspace without root package),
	# so install the app crate by path; orbit-rpc is a library-only helper
	cargo_src_install --path ./crates/orbit-pi
	dodoc README.md CHANGELOG.md
	domenu "${FILESDIR}"/orbit-pi.desktop
	newicon -s 1024 assets/icons/icon.png orbit-pi.png
}
