	media-libs/alsa-lib
	dev-libs/openssl:=
	x11-libs/gtk+:3
	net-libs/webkit-gtk:4.1
	net-libs/libsoup:3.0
	dev-libs/libayatana-appindicator
"
RDEPEND="${DEPEND}"

src_prepare() {
	# tauri-codegen embeds frontendDist at compile time; provide an empty dist
	# so cargo can proceed. The app uses assetProtocol to serve UI at runtime.
	mkdir -p dist || die
	default
}

src_compile() {
	cargo_src_compile --manifest-path src-tauri/Cargo.toml
}

src_install() {
	cargo_src_install --path src-tauri
	dodoc README.md
}
