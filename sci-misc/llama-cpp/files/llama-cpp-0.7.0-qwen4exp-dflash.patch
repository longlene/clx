https://github.com/ggml-org/llama.cpp/pull/30927

model : fix qwen4exp layer inputs for DFlash drafters

qwen4exp exposes its [n_embd, hc, T] hyper-connection residual as
t_layer_inp, crashing DFlash drafters (GGML_ASSERT row_floats == n_embd).
Collapse the streams with a mean for the layers a drafter requests.

diff --git a/src/models/qwen4exp.cpp b/src/models/qwen4exp.cpp
index 22e7159840b9..4cf090d1b6c1 100644
--- a/src/models/qwen4exp.cpp
+++ b/src/models/qwen4exp.cpp
@@ -308,6 +308,20 @@ std::unique_ptr<llm_graph_context> llama_model_qwen4exp::build_arch_graph(const
     return std::make_unique<graph>(*this, params);
 }
 
+// DFlash drafters read the layer inputs as [n_embd, T] rows, so collapse the streams
+static ggml_tensor * hc_stream_mean(ggml_context * ctx, ggml_tensor * x) {
+    const int64_t n_embd = x->ne[0];
+    const int64_t hc     = x->ne[1];
+    const int64_t nt     = x->ne[2];
+
+    ggml_tensor * acc = ggml_view_2d(ctx, x, n_embd, nt, x->nb[2], 0);
+    for (int64_t s = 1; s < hc; ++s) {
+        acc = ggml_add(ctx, acc, ggml_view_2d(ctx, x, n_embd, nt, x->nb[2], s*x->nb[1]));
+    }
+
+    return ggml_scale(ctx, acc, 1.0f / (float) hc);
+}
+
