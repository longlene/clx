inherit cargo

# A dependency crate pins rust-version = 1.88.0 (cargo QA notice).
RUST_MIN_VER="1.88.0"

DESCRIPTION="Terminal coding agent with a streaming REPL, in a single Rust binary"
HOMEPAGE="https://github.com/okikorg/orca-harness"
# Release tags carry the product-name prefix: orcacode-v${PV}.
SRC_URI="
	https://github.com/okikorg/orca-harness/archive/refs/tags/orcacode-v${PV}.tar.gz -> ${P}.gh.tar.gz
	${CARGO_CRATE_URIS}
"
S="${WORKDIR}/orca-harness-orcacode-v${PV}"

LICENSE="Apache-2.0"
# Dependent crate licenses
LICENSE+="
	BSD-2 BSD CC0-1.0 CDLA-Permissive-2.0 ISC MIT Unicode-3.0 ZLIB
"
SLOT="0"
KEYWORDS="~amd64"
RESTRICT="test"

# rustls-native-certs loads the system CA bundle at runtime
RDEPEND="app-misc/ca-certificates"

pkg_setup() {
	rust_pkg_setup
}

src_compile() {
	cargo_src_compile --package orcacode
}

src_install() {
	dobin "$(cargo_target_dir)/orcacode"
	dodoc README.md NOTICE
}
