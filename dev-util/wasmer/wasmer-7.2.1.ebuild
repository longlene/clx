RUST_MIN_VER="1.93"

inherit cargo

DESCRIPTION="Universal web assembly runtime"
HOMEPAGE="https://wasmer.io"
SRC_URI="
	https://github.com/wasmerio/wasmer/archive/refs/tags/v${PV}.tar.gz -> ${P}.gh.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="MIT 0BSD Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD BSD-2 Boost-1.0 CDLA-Permissive-2.0 ISC MPL-2.0 UoI-NCSA Unicode-3.0 ZLIB"
SLOT="0"
KEYWORDS="~amd64"

BDEPEND="
	dev-build/cmake
"

src_prepare() {
	# lib/napi is a git submodule we don't fetch (not needed: the "napi-v8"
	# feature that references it is not enabled). Cargo still resolves the
	# manifest of every path dependency regardless of feature activation, so
	# drop the workspace member entry and the optional dependency itself.
	sed -e '/"lib\/napi",/d' -i Cargo.toml || die
	sed -e '/^napi-v8 = /d' -e '/^wasmer-napi = /d' -i lib/cli/Cargo.toml || die
	default
}

src_compile() {
	cargo_src_compile --manifest-path lib/cli/Cargo.toml --features "singlepass,cranelift"
}

src_install() {
	cargo_src_install --path lib/cli
	einstalldocs
}
