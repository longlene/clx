	https://github.com/aaif-goose/goose
"
SRC_URI="
	https://github.com/aaif-goose/goose/archive/refs/tags/v${PV}.tar.gz -> ${P}.gh.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="Apache-2.0"
# Dependent crate licenses
LICENSE+="
	Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD-2 BSD Boost-1.0
	CC0-1.0 CDLA-Permissive-2.0 ISC LGPL-3+ MIT MIT-0 MPL-2.0
	Unicode-3.0 ZLIB BZIP2
"
SLOT="0"
KEYWORDS="~amd64"

RDEPEND="${DEPEND}"

src_prepare() {
	default

	# cargo's [patch] mechanism in config.toml fails in offline mode when the
	# lock file still references the git source.  Replace the workspace git dep
	# with the extracted local path so cargo never tries to reach the network.
	local commit
	IFS=';' read -r _ commit _ <<< "${GIT_CRATES[cudaforge]}"
	local git_dep="cudaforge = { git = \"https://github.com/jbg/cudaforge\", rev = \"${commit}\" }"
	local path_dep="cudaforge = { path = \"${WORKDIR}/cudaforge-${commit}\" }"
	sed -i "s|${git_dep}|${path_dep}|" Cargo.toml || die "Failed to patch Cargo.toml for cudaforge"

	# Strip the git source line from Cargo.lock; path deps carry no source entry.
	sed -i \
		'/^source = "git+https:\/\/github\.com\/jbg\/cudaforge/d' \
		Cargo.lock || die "Failed to patch Cargo.lock for cudaforge"
}

src_install() {
	#cargo_src_install --path ./crates/goose-server
	cargo_src_install --path ./crates/goose-cli
	einstalldocs
}
