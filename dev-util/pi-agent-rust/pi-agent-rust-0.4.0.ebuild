RUST_MIN_VER="1.95.0"

inherit cargo

DESCRIPTION="High-performance AI coding agent CLI - Rust port of Pi Agent"
HOMEPAGE="https://github.com/Dicklesworthstone/pi_agent_rust"
SRC_URI="
	https://github.com/Dicklesworthstone/pi_agent_rust/archive/refs/tags/v${PV}.tar.gz -> ${P}.gh.tar.gz
	${CARGO_CRATE_URIS}
"

S="${WORKDIR}"/pi_agent_rust-${PV}

LICENSE="MIT"
LICENSE+=" Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD-2 BSD Boost-1.0
	CDLA-Permissive-2.0 ISC MIT MIT-0 MPL-2.0 UoI-NCSA Unicode-3.0 ZLIB"
SLOT="0"
KEYWORDS="~amd64"

RDEPEND="${DEPEND}"

src_configure() {
	# deps (asupersync, fsqlite family) use unstable features; upstream
	# pins a nightly toolchain in rust-toolchain.toml
	export RUSTC_BOOTSTRAP=1
	cargo_src_configure
}

src_install() {
	cargo_src_install --bin pi
	einstalldocs
}
