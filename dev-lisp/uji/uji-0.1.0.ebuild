inherit cargo

DESCRIPTION="A coding agent you can shape with Lua"
HOMEPAGE="https://github.com/uji-labs/uji"
SRC_URI="
	https://github.com/uji-labs/uji/archive/refs/tags/v${PV}.tar.gz -> ${P}.gh.tar.gz
	${CARGO_CRATE_URIS}
"
S="${WORKDIR}/uji-${PV}"

LICENSE="GPL-3"
# Dependent crate licenses
LICENSE+="
	Apache-2.0 BSD Boost-1.0 ISC MIT MPL-2.0 Unicode-3.0 Unicode-DFS-2016 WTFPL-2 ZLIB
"
SLOT="0"
KEYWORDS="~amd64"

# The LuaJIT interpreter is vendored (mlua "luajit52" + "vendored"); no system
# Lua is needed. Runtime deps are the TLS stack (reqwest native-tls) and the
# SQLite backend (rusqlite, un-bundled libsqlite3-sys).
RDEPEND="
	dev-libs/openssl
	dev-db/sqlite
"
DEPEND="${RDEPEND}"

# Virtual-manifest workspace; the default compile builds all members and only
# the CLI binary is installed (the Lua standard library ships embedded in the
# binary via uji-lua's build.rs). The eclass leaves CARGO_TARGET_DIR unset,
# so cargo puts artifacts in the workspace root's target/ dir (cwd is ${S}).
cargo_src_install() {
	# dobin hardcodes `install -o 0 -g 0` (fails unprivileged); use doins.
	insinto /usr/bin
	doins "$(cargo_target_dir)"/uji
}
