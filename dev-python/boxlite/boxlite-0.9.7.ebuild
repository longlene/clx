EPYTEST_PLUGINS=()
distutils_enable_tests pytest

# The workspace's -sys crates (libkrun-sys, e2fsprogs-sys, bubblewrap-sys) vendor
# their native sources as git submodules, which a plain GitHub archive omits, and
# their default build otherwise fetches prebuilt binaries over the network. Both
# are unavailable in the portage sandbox; BOXLITE_DEPS_STUB=1 is upstream's own
# supported no-vendor/no-network build mode (see src/boxlite/build.rs).
export BOXLITE_DEPS_STUB=1

python_prepare_all() {
	# The workspace's own Cargo.toml re-patches libcontainer from crates-io to
	# the same youki git rev that GIT_CRATES already vendors locally (via
	# cargo.eclass's [patch.'https://github.com/youki-dev/youki'] in
	# .cargo/config.toml). Cargo doesn't chain a crates-io -> git patch with a
	# git -> local-path patch in --offline mode; `cargo metadata` still tries
	# to fetch the git URL and dies with "you are in the offline mode".
	# Repoint the workspace's own patch straight at the vendored checkout to
	# skip that hop.
	local youki_rev="4b2f0e00a4a11107f3a338c21c17407d2f664ec9"
	local youki_dir="${WORKDIR}/youki-${youki_rev}/crates/libcontainer"
	sed -i \
		-e "s|git = \"https://github.com/youki-dev/youki\", rev = \"${youki_rev}\"|path = \"${youki_dir}\"|" \
		"${WORKDIR}/${P}/Cargo.toml" || die

	distutils-r1_python_prepare_all
}
