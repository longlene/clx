diff -Nur a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt	2026-05-07 09:50:13.000000000 -0700
+++ b/CMakeLists.txt	2026-05-09 16:38:19.415507378 -0700
@@ -114,6 +114,57 @@
 include(AddLLVM)
 include(AddMLIR)
 
+# Gentoo ships monolithic libMLIR.so and libLLVM.so without individual component
+# cmake targets. Create INTERFACE shim targets so triton's direct
+# target_link_libraries() calls resolve correctly.
+foreach(_mlir_shim
+  MLIRAMDGPUDialect MLIRAnalysis MLIRArithDialect MLIRArithToLLVM
+  MLIRBuiltinToLLVMIRTranslation MLIRBytecodeWriter MLIRControlFlowToLLVM
+  MLIRGPUDialect MLIRGPUToGPURuntimeTransforms
+  MLIRGPUToNVVMTransforms MLIRGPUToROCDLTransforms MLIRGPUTransforms
+  MLIRIndexToLLVM MLIRIR MLIRLLVMDialect MLIRLLVMToLLVMIRTranslation
+  MLIRLspServerLib MLIRMathDialect MLIRMathToLLVM MLIRNVVMDialect
+  MLIRNVVMToLLVM MLIRNVVMToLLVMIRTranslation MLIROptLib MLIRParser
+  MLIRPass MLIRPluginsLib MLIRReconcileUnrealizedCasts MLIRReduceLib
+  MLIRRegisterAllDialects MLIRRegisterAllPasses MLIRROCDLToLLVMIRTranslation
+  MLIRSCFDialect MLIRSCFToControlFlow MLIRSupport MLIRTargetLLVMIRExport
+  MLIRTransforms MLIRTransformUtils MLIRUBToLLVM
+)
+  if(NOT TARGET ${_mlir_shim})
+    add_library(${_mlir_shim} INTERFACE)
+    target_link_libraries(${_mlir_shim} INTERFACE MLIR)
+  endif()
+endforeach()
+
+foreach(_llvm_shim
+  LLVMAArch64AsmParser LLVMAArch64CodeGen LLVMAMDGPUAsmParser LLVMAMDGPUCodeGen
+  LLVMAnalysis LLVMCodeGen LLVMCore LLVMNVPTXCodeGen LLVMOption
+  LLVMPasses LLVMPowerPCAsmParser LLVMPowerPCCodeGen
+  LLVMX86AsmParser LLVMX86CodeGen
+)
+  if(NOT TARGET ${_llvm_shim})
+    add_library(${_llvm_shim} INTERFACE)
+    target_link_libraries(${_llvm_shim} INTERFACE LLVM)
+  endif()
+endforeach()
+
+# Gentoo's LLVMExports.cmake defines LLVMSupport/LLVMDemangle as STATIC IMPORTED
+# pointing to libLLVMSupport.a. If linked statically into libtriton.so, they create
+# a separate cl::GlobalParser from libLLVM.so's, breaking cl::getRegisteredOptions()
+# lookups (e.g. nvptx-short-ptr) at runtime. Redirect to the monolithic libLLVM.so
+# instead of embedding duplicate static archives.
+foreach(_force_dynamic LLVMSupport LLVMDemangle)
+  if(TARGET ${_force_dynamic})
+    set(_llvm_so "${LLVM_LIBRARY_DIR}/libLLVM.so")
+    get_property(_imp_configs TARGET ${_force_dynamic} PROPERTY IMPORTED_CONFIGURATIONS)
+    set_property(TARGET ${_force_dynamic} PROPERTY IMPORTED_LOCATION "${_llvm_so}")
+    foreach(_cfg ${_imp_configs})
+      set_property(TARGET ${_force_dynamic} PROPERTY "IMPORTED_LOCATION_${_cfg}" "${_llvm_so}")
+    endforeach()
+    set_property(TARGET ${_force_dynamic} PROPERTY INTERFACE_LINK_LIBRARIES "")
+  endif()
+endforeach()
+
 # Utilities
 function(add_triton_object name)
   cmake_parse_arguments(ARG "" "" "DEPENDS;LINK_LIBS" ${ARGN})
