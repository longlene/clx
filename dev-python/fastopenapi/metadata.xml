    models, with router adapters for AioHttp, Django, Falcon, Flask, Quart,
    Sanic, Starlette, and Tornado.
  </longdescription>
  <use>
    <flag name="aiohttp">Enable AioHttp router integration</flag>
    <flag name="django">Enable Django router integration</flag>
    <flag name="falcon">Enable Falcon router integration</flag>
    <flag name="flask">Enable Flask router integration</flag>
    <flag name="quart">Enable Quart router integration</flag>
    <flag name="sanic">Enable Sanic router integration</flag>
    <flag name="starlette">Enable Starlette router integration</flag>
    <flag name="tornado">Enable Tornado router integration</flag>
  </use>
  <upstream>
