PYTHON_COMPAT=( python3_{13..15} )

inherit cargo distutils-r1

DESCRIPTION="Python bindings for LanceDB"
HOMEPAGE="
	https://pypi.org/project/lancedb/
	https://github.com/lancedb/lancedb
"
