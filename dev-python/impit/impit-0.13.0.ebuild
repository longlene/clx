RUST_MIN_VER="1.88.0"

inherit cargo distutils-r1

DESCRIPTION="HTTP requests library with browser impersonation support"
HOMEPAGE="https://github.com/apify/impit https://pypi.org/project/impit/"
SRC_URI="
	https://files.pythonhosted.org/packages/ef/9b/f2712e01fe0ce1626786ecb088984fca909fd19d57e03a3545b6ab9b8f0c/impit-${PV}.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD CDLA-Permissive-2.0 CC0-1.0 ISC MIT MPL-2.0 Unicode-3.0 ZLIB"
SLOT="0"
KEYWORDS="~amd64"
RESTRICT="test"

DEPEND="dev-libs/openssl:="
RDEPEND="${DEPEND}"

python_compile() {
	local -x RUSTFLAGS="${RUSTFLAGS} --cfg reqwest_unstable"
	distutils-r1_python_compile
}

src_prepare() {
	# Replace [patch.crates-io] git sources with local extracted paths
	local w="${WORKDIR}"
	local h2_rev="7f393a728a8db07cabb1b78d2094772b33943b9a"
	local rustls_rev="1ebb6d466a557858cdd8c836ffcbb26d04d7a9f9"
	local tower_rev="f9efc0d9193e774d33aedc1022b922efefc22052"
	local hyper_rev="9b7795dfd7158fc55e7c84b65bf1dae1d2dea67d"
	sed -i \
		-e "s|^h2 = { git = .*}|h2 = { path = \"${w}/h2-${h2_rev}\" }|" \
		-e "s|^rustls = { git = .*}|rustls = { path = \"${w}/rustls-${rustls_rev}/rustls\" }|" \
		-e "s|^tower-http = { git = .*}|tower-http = { path = \"${w}/tower-http-${tower_rev}/tower-http\" }|" \
		-e "s|^hyper-util = { git = .*}|hyper-util = { path = \"${w}/hyper-util-${hyper_rev}\" }|" \
		"${S}/Cargo.toml" || die
	distutils-r1_src_prepare
}
