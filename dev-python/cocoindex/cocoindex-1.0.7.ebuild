DISTUTILS_EXT=1
DISTUTILS_USE_PEP517=maturin
PYTHON_COMPAT=( python3_{13..15} )

inherit cargo distutils-r1

DESCRIPTION="Incremental data indexing engine for AI agents and RAG pipelines"
HOMEPAGE="https://cocoindex.io/ https://github.com/cocoindex-io/cocoindex"
SRC_URI="https://github.com/cocoindex-io/cocoindex/archive/refs/tags/v${PV}.tar.gz -> ${P}.gh.tar.gz
	${CARGO_CRATE_URIS}"

LICENSE="Apache-2.0"
SLOT="0"
KEYWORDS="~amd64"
IUSE="amazon-s3 google-drive neo4j postgres qdrant"
RESTRICT="test"

src_prepare() {
	# Cargo workspace uses 999.0.0 as a placeholder; set the real release version
	sed -i "s/^version = \"999.0.0\"/version = \"${PV}\"/" Cargo.toml || die
	distutils-r1_src_prepare
}

DEPEND="dev-db/sqlite:3="
