DISTUTILS_USE_PEP517=maturin
PYTHON_COMPAT=( python3_{13..15} )

inherit cargo distutils-r1

DESCRIPTION="Multi-language agent runtime for execution scope and lifecycle management"
HOMEPAGE="
	https://pypi.org/project/nemo-relay/
	https://github.com/NVIDIA/NeMo-Relay
"
SRC_URI="
	https://github.com/NVIDIA/NeMo-Relay/archive/refs/tags/${PV}.tar.gz -> ${P}.gh.tar.gz
	${CARGO_CRATE_URIS}
"
S="${WORKDIR}/NeMo-Relay-${PV}"

LICENSE="Apache-2.0"
SLOT="0"
KEYWORDS="~amd64"

python_install() {
	distutils-r1_python_install

	# maturin's [tool.maturin.include] bundles LICENSE at the wheel root,
	# landing as a stray top-level file in site-packages
	rm -f "${D}"/usr/lib/python*/site-packages/LICENSE || die
}
