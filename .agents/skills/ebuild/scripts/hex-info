#!/usr/bin/env python3
"""
Usage: hex-info PKGNAME [VERSION]
       hex-info https://hex.pm/packages/PKGNAME

Print Hex.pm package info: GitHub repo link and optionally release details.
Useful for mapping Erlang hex package names to their GitHub source.
"""
import json, sys, urllib.request, re

def main():
    if not sys.argv[1:] or sys.argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        sys.exit(0 if sys.argv[1:] else 1)
    arg = sys.argv[1]
    version = sys.argv[2] if len(sys.argv) > 2 else None

    m = re.search(r'hex\.pm/packages/([^/]+)', arg)
    name = m.group(1) if m else arg

    def get(url):
        req = urllib.request.Request(url, headers={"Accept": "application/json"})
        with urllib.request.urlopen(req) as r:
            return json.load(r)

    d = get(f"https://hex.pm/api/packages/{name}")
    print(f"name:     {d.get('name')}")
    links = d.get('meta', {}).get('links', {})
    for k, v in links.items():
        print(f"link:     {k}: {v}")

    if version:
        rel = get(f"https://hex.pm/api/packages/{name}/releases/{version}")
        print(f"version:  {rel.get('version')}")
        meta = rel.get('meta', {})
        print(f"app:      {meta.get('app')}")
        print(f"tools:    {meta.get('build_tools')}")
    else:
        releases = d.get('releases', [])[:5]
        if releases:
            print("versions: " + ", ".join(r['version'] for r in releases))

if __name__ == "__main__":
    main()
