RUST_MIN_VER="1.88.0"

declare -A GIT_CRATES=(
	[perf-event-open-sys]='https://github.com/Nero5023/perf-event;6dae86b6d4807acec081e6dc0a53167f57f8c0f4;perf-event-%commit%/perf-event-open-sys'
	[perf-event]='https://github.com/Nero5023/perf-event;6dae86b6d4807acec081e6dc0a53167f57f8c0f4;perf-event-%commit%/perf-event'
	[probminhash]='https://github.com/krallin/probminhash;3d6b7a5315305c2893a7a04e0de9e23b305992c5;probminhash-%commit%'
	[sorted_vector_map]='https://github.com/facebookexperimental/rust-shed;21296554c467a65395a4ea6c85002aac8c14f2dd;rust-shed-%commit%/shed/sorted_vector_map'
)

inherit cargo

MY_PV=${PV//./-}

DESCRIPTION="Fast multi-language build system"
HOMEPAGE="
	https://github.com/facebook/buck2
	https://buck2.build/
"
SRC_URI="
	https://github.com/facebook/buck2/archive/refs/tags/${MY_PV}.tar.gz -> ${P}.tar.gz
	${CARGO_CRATE_URIS}
"

S="${WORKDIR}"/${PN}-${MY_PV}

LICENSE="Apache-2.0 MIT"
SLOT="0"
KEYWORDS="~amd64"

DEPEND="
	app-arch/zstd
"
RDEPEND="${DEPEND}"

export ZSTD_SYS_USE_PKG_CONFIG=1
# buck2 uses numerous nightly-only Rust features in its source tree
export RUSTC_BOOTSTRAP=1
# buck2 uses tokio unstable runtime metrics APIs
RUSTFLAGS+=" --cfg tokio_unstable"

src_prepare() {
	default
	local perf_commit="6dae86b6d4807acec081e6dc0a53167f57f8c0f4"
	local probminhash_commit="3d6b7a5315305c2893a7a04e0de9e23b305992c5"
	local rust_shed_commit="21296554c467a65395a4ea6c85002aac8c14f2dd"
	# cargo generate-lockfile cannot follow git→path patch chains offline.
	# Replace all git sources across the workspace with extracted GIT_CRATES paths.
	local perf_path="${WORKDIR}/perf-event-${perf_commit}"
	local prob_path="${WORKDIR}/probminhash-${probminhash_commit}"
	local shed_path="${WORKDIR}/rust-shed-${rust_shed_commit}/shed/sorted_vector_map"
	local perf_git="git = \"https://github.com/Nero5023/perf-event.git\", rev = \"${perf_commit}\""
	local prob_git="git = \"https://github.com/krallin/probminhash\", rev = \"${probminhash_commit}\""
	local shed_git="git = \"https://github.com/facebookexperimental/rust-shed\""
	local r_pe="perf-event = { path = \"${perf_path}/perf-event\", version = \"0.4\" }"
	local r_peos="perf-event-open-sys = { path = \"${perf_path}/perf-event-open-sys\", version = \"5.0\" }"
	find . -name Cargo.toml -exec sed -i \
		-e "s|perf-event = { ${perf_git}, version = \"0.4\" }|${r_pe}|" \
		-e "s|perf-event-open-sys = { ${perf_git}, version = \"5.0\" }|${r_peos}|" \
		-e "s|${prob_git}, |path = \"${prob_path}\", |" \
		-e "s|sorted_vector_map.${shed_git}|sorted_vector_map.path = \"${shed_path}\"|" \
		-e 's/, "nightly_portable_simd"//g' \
		-e 's/, "nightly_stdsimd"//g' \
		-e 's/, "specialization"//g' \
		{} + || die
	# Remove [patch.'git_url'] blocks — now unused (all git deps replaced by paths)
	# and would cause cargo to attempt git connections in offline mode.
	sed -i '/^\[patch\./,$d' "${CARGO_HOME}/config.toml" || die
	# Disable the hard-coded nightly toolchain version check in the build script.
	sed -i 's/if !cfg!(fbcode_build)/if false/' app/buck2_core/build.rs || die
	# allocative/build.rs gates specialization impls on "nightly" in rustc version;
	# also honour RUSTC_BOOTSTRAP so Gentoo's stable rustc sets the rust_nightly cfg.
	local allo_check='stdout.contains("nightly") || stdout.contains("dev")'
	local allo_extra='|| std::env::var("RUSTC_BOOTSTRAP").is_ok_and(|v| v == "1")'
	sed -i "s|${allo_check}|${allo_check} ${allo_extra}|" \
		allocative/allocative/build.rs || die
	cargo generate-lockfile || die
}

src_compile() {
	cargo_src_compile --manifest-path app/buck2/Cargo.toml
}

src_install() {
	cargo_src_install --path app/buck2
	einstalldocs
}
